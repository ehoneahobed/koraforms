# Server
PORT=3001
KORA_AUTH_SECRET=change-me-to-a-random-string

# Operational endpoints.
# Set KORA_METRICS_TOKEN in production to protect /api/ops/diagnostics.
# KORA_ADMIN_TOKEN=change-me
# KORA_METRICS_TOKEN=change-me
# KORA_BACKUP_TOKEN=change-me

# Database
# Use DATABASE_URL for public deployments. DB_PATH is local/demo only.
# DATABASE_URL=postgresql://user:password@host:5432/koraforms?sslmode=require
DB_PATH=./koraforms-server.db

# Public URL (for OG meta tags and links)
PUBLIC_URL=https://koraforms.app

# Client-side (must be prefixed with VITE_)
VITE_SYNC_URL=ws://localhost:3001/kora-sync
VITE_AUTH_URL=http://localhost:3001
