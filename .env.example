# Settings KoraForms reads. A comment describes the variables right below it; tags set the
# rules: [required] production needs it, [secret] a credential, [development] local only.
# Hosts (Kora Cloud included) read this file to know what to ask for. Copy it to .env locally.

# [development] Server port; hosts set PORT themselves.
PORT=3001

# [required] [secret] Signs sign-in sessions. Generate a long random value.
KORA_AUTH_SECRET=

# [secret] Bearer tokens for the operational endpoints. KORA_METRICS_TOKEN protects
# /api/ops/diagnostics; set all three in production.
KORA_ADMIN_TOKEN=
KORA_METRICS_TOKEN=
KORA_BACKUP_TOKEN=

# Proxy hops trusted for X-Forwarded-For (client IP for rate limits). Production defaults
# to 1 (Azure Container Apps ingress, fly-proxy); set 0 when the server is reached directly.
KORA_TRUST_PROXY=

# Production database, e.g. postgresql://user:password@host:5432/koraforms?sslmode=require.
# Without it the server uses SQLite at DB_PATH, which is for local use and demos only.
DATABASE_URL=

# [development] SQLite file used when DATABASE_URL is empty.
DB_PATH=./koraforms-server.db

# [required] Public origin, for links in emails and link previews.
PUBLIC_URL=https://koraforms.app

# Where uploaded files are kept. Hosts such as Kora Cloud set KORA_BLOB_STORE_URL or
# KORA_BLOB_DIR; BLOB_STORE_PATH is the older KoraForms setting, still honoured. Without
# any of them files go to ./koraforms-blobs, which is not durable on a container host.
KORA_BLOB_STORE_URL=
KORA_BLOB_DIR=
BLOB_STORE_PATH=

# [required] [secret] Sends invitation, verification and password-reset emails. Outside
# production, emails are logged instead.
RESEND_API_KEY=

# [required] Sender for every email, on a domain verified in Resend.
EMAIL_FROM="KoraForms <info@korajs.dev>"

# [development] File the end-to-end tests read emails from, outside production.
KORAFORMS_DEV_MAILBOX=

# Client-side (compiled into the browser bundle, so never secret).
VITE_SYNC_URL=ws://localhost:3001/kora-sync
VITE_AUTH_URL=http://localhost:3001
VITE_EMAIL_NOTIFICATIONS_ENABLED=false
