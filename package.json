{
  "name": "koraforms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,server -c cyan,green \"vite\" \"node --import tsx --watch server.ts\"",
    "dev:vite": "vite",
    "dev:e2e": "vite --host 127.0.0.1 --port 4175 --strictPort",
    "dev:server": "node --import tsx --watch server.ts",
    "build": "vite build",
    "preview:e2e": "pnpm run build && vite preview --host 127.0.0.1 --port 4175 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.js",
    "test:e2e": "playwright test",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "start": "node --import tsx server.ts",
    "preview": "vite build && node --import tsx server.ts",
    "doctor": "kora doctor",
    "studio": "kora studio --db ./koraforms-server.db",
    "studio:live": "kora studio --connect ws://localhost:3001/kora-sync --schema ./src/schema.ts",
    "studio:prod": "node scripts/studio-prod.js",
    "studio:lab": "kora studio --lab --schema ./src/schema.ts",
    "logs": "kora logs --url http://localhost:3001",
    "postinstall": "node scripts/patch-server.js"
  },
  "dependencies": {
    "@korajs/auth": "1.0.0-beta.0",
    "@korajs/core": "1.0.0-beta.0",
    "@korajs/react": "1.0.0-beta.0",
    "@korajs/server": "1.0.0-beta.0",
    "@korajs/store": "1.0.0-beta.0",
    "@sqlite.org/sqlite-wasm": ">=3.51.0-build1",
    "better-sqlite3": "^12.9.0",
    "korajs": "1.0.0-beta.0",
    "lucide-react": "^0.468.0",
    "postgres": "^3.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.0",
    "tsx": "^4.19.0",
    "ws": "^8.18.0",
    "yjs": "^13.6.30"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@korajs/cli": "1.0.0-beta.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
